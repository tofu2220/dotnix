{
  "layer": "top",
  "position": "top",
  "margin-bottom": -10,
  "spacing": 0,
  "modules-left": ["niri/workspaces", "memory", "cpu"],
  "modules-center": ["clock", "custom/notification"],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
  ],
  "include": [
    "modules/workspaces.jsonc",
    "modules/memory.jsonc",
    "modules/cpu.jsonc",
    "modules/clock.jsonc",
    "modules/notification.jsonc",
    "modules/tray.jsonc",
    "modules/bluetooth.jsonc",
    "modules/network.jsonc",
    "modules/pulseaudio.jsonc",
    "modules/backlight.jsonc",
    "modules/battery.jsonc",
  ],
}
